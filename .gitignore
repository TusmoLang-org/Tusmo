# Ignore everything in the root by default
/*

# ------------------------------------------------------------------
# EXPLICITLY ALLOWED FOLDERS AND FILES (Do not ignore these)
# ------------------------------------------------------------------
!/README.md
!/compiler/
!/Extension/
!/runtime/
!/stdlib/
!/tusmo.py
!/.gitignore
!/docs/
!/mkdocs.yml

# ------------------------------------------------------------------
# IGNORE SPECIFIC JUNK FILES INSIDE ALLOWED FOLDERS
# ------------------------------------------------------------------
# Python
__pycache__/
*.pyc
*.pyo
*.pyd

# PLY Parser generated files
*.out
parsetab.py
tusmo_lib_index.json

# Node / JS
node_modules/

# IDE / Profiling
.vscode/
*.massif
.codex
