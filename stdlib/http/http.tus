#include <arpa/inet.h>
#include <errno.h>
#include <netinet/in.h>
#include <stdio.h>
#include <stdlib.h>
#include <string.h>
#include <sys/socket.h>
#include <unistd.h>

int c_http_listen(int port) {
    int fd = socket(AF_INET, SOCK_STREAM, 0);
    if (fd < 0) return -1;
    int opt = 1;
    setsockopt(fd, SOL_SOCKET, SO_REUSEADDR, &opt, sizeof(opt));
    struct sockaddr_in addr;
    memset(&addr, 0, sizeof(addr));
    addr.sin_family = AF_INET;
    addr.sin_addr.s_addr = htonl(INADDR_ANY);
    addr.sin_port = htons((uint16_t)port);
    if (bind(fd, (struct sockaddr*)&addr, sizeof(addr)) < 0) {
        close(fd);
        return -1;
    }
    if (listen(fd, 10) < 0) {
        close(fd);
        return -1;
    }
    return fd;
}

int c_http_accept(int server_fd) {
    struct sockaddr_in client_addr;
    socklen_t addr_len = sizeof(client_addr);
    return accept(server_fd, (struct sockaddr*)&client_addr, &addr_len);
}

char* c_http_read(int client_fd) {
    char* buffer = (char*)malloc(4096);
    int n = recv(client_fd, buffer, 4095, 0);
    if (n <= 0) {
        free(buffer);
        return NULL;
    }
    buffer[n] = 0;
    return buffer;
}

void c_http_send(int client_fd, const char* response) {
    send(client_fd, response, strlen(response), 0);
    close(client_fd);
}

void c_http_send_response(int client_fd, int status, const char* content_type, const char* body) {
    if (!content_type) content_type = "text/plain; charset=utf-8";
    if (!body) body = "";

    const char* status_text = "OK";
    switch (status) {
        case 201: status_text = "Created"; break;
        case 400: status_text = "Bad Request"; break;
        case 404: status_text = "Not Found"; break;
        case 405: status_text = "Method Not Allowed"; break;
        case 500: status_text = "Internal Server Error"; break;
        default: status_text = "OK"; break;
    }

    int body_len = (int)strlen(body);
    char header[512];
    int hn = snprintf(
        header, sizeof(header),
        "HTTP/1.1 %d %s\\r\\nContent-Type: %s\\r\\nContent-Length: %d\\r\\nConnection: close\\r\\n\\r\\n",
        status, status_text, content_type, body_len
    );
    if (hn < 0) {
        close(client_fd);
        return;
    }

    send(client_fd, header, (size_t)hn, 0);
    if (body_len > 0) {
        send(client_fd, body, (size_t)body_len, 0);
    }
    close(client_fd);
}

char* c_http_method(const char* raw) {
    if (!raw) return strdup("GET");
    const char* sp = strchr(raw, ' ');
    if (!sp) return strdup("GET");
    size_t n = (size_t)(sp - raw);
    char* out = (char*)malloc(n + 1);
    if (!out) return strdup("GET");
    memcpy(out, raw, n);
    out[n] = 0;
    return out;
}

char* c_http_path(const char* raw) {
    if (!raw) return strdup("/");
    const char* sp1 = strchr(raw, ' ');
    if (!sp1) return strdup("/");
    sp1++;
    const char* sp2 = strchr(sp1, ' ');
    if (!sp2) return strdup("/");
    size_t n = (size_t)(sp2 - sp1);
    char* out = (char*)malloc(n + 1);
    if (!out) return strdup("/");
    memcpy(out, sp1, n);
    out[n] = 0;
    return out;
}

