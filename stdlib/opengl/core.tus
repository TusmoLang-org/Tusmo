#include <GLFW/glfw3.h>
#include <stdio.h>
#include <stdbool.h>

static GLFWwindow* daaqada_tusmo = NULL;

int gl_bilow_nidaamka() {
    if (!glfwInit()) return 0;
    return 1;
}

int gl_sameey_daaqad(int b, int d, const char* c) {
    daaqada_tusmo = glfwCreateWindow(b, d, c, NULL, NULL);
    if (!daaqada_tusmo) {
        glfwTerminate();
        return 0;
    }
    glfwMakeContextCurrent(daaqada_tusmo);
    return 1;
}

int gl_miyey_xirmaysaa() {
    if (!daaqada_tusmo) return 1;
    return glfwWindowShouldClose(daaqada_tusmo);
}

void gl_soo_muuji() {
    if (daaqada_tusmo) glfwSwapBuffers(daaqada_tusmo);
}

void gl_hubi_dhacdooyinka() {
    glfwPollEvents();
}

void gl_midabka_masaxida(double r, double g, double b, double a) {
    glClearColor((float)r, (float)g, (float)b, (float)a);
}

void gl_nadiifi(int mask) {
    glClear(mask);
}

void gl_hab_muuqa(int x, int y, int b, int d) {
    glViewport(x, y, b, d);
}

void gl_dib_u_deji() {
    glLoadIdentity();
}

void gl_matrix_mode(int mode) {
    glMatrixMode(mode);
}

void gl_ortho(double l, double r, double b, double t, double n, double f) {
    glOrtho(l, r, b, t, n, f);
}

void gl_bilow(int mode) {
    glBegin(mode);
}

void gl_dhameey() {
    glEnd();
}

void gl_bar_2d(double x, double y) {
    glVertex2f((float)x, (float)y);
}

void gl_midab(double r, double g, double b) {
    glColor3f((float)r, (float)g, (float)b);
}

void gl_xir_nidaamka() {
    glfwTerminate();
}

double gl_jiir_x() {
    if (!daaqada_tusmo) return 0.0;
    double x, y;
    glfwGetCursorPos(daaqada_tusmo, &x, &y);
    return x;
}

double gl_jiir_y() {
    if (!daaqada_tusmo) return 0.0;
    double x, y;
    glfwGetCursorPos(daaqada_tusmo, &x, &y);
    return y;
}

int gl_jiir_ma_riixan_yahay(int button) {
    if (!daaqada_tusmo) return 0;
    return glfwGetMouseButton(daaqada_tusmo, button) == GLFW_PRESS;
}
""");

