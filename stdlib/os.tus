// stdlib/os.tus

___c__code_("""
#include <unistd.h>
#include <stdio.h>
#include <stdlib.h>
#include <string.h>
#include <sys/stat.h>
#include <dirent.h>
#include <sys/wait.h>
#include <stdbool.h>

// Forward declarations and helpers
char* tusmo_strdup(const char* s);
TusmoTixEray* tusmo_hp_tix_eray_create(size_t cap);
void tusmo_hp_tix_eray_append(TusmoTixEray* tix, char* value);

char* tusmo_os_cwd() {
    char* buf = (char*)malloc(1024 * sizeof(char));
    if (getcwd(buf, 1024) != NULL) {
        return buf;
    } else {
        perror("getcwd");
        return "";
    }
}

void tusmo_os_cd(char* path) {
    if (chdir(path) != 0) {
        perror("chdir");
    }
}

TusmoTixEray* tusmo_os_list_dir(char* path) {
    TusmoTixEray* list = tusmo_hp_tix_eray_create(8);
    DIR *d;
    struct dirent *dir;
    d = opendir(path);
    if (d) {
        while ((dir = readdir(d)) != NULL) {
            tusmo_hp_tix_eray_append(list, tusmo_strdup(dir->d_name));
        }
        closedir(d);
    }
    return list;
}

void tusmo_os_mkdir(char* path) {
    if (mkdir(path, 0777) != 0) {
        perror("mkdir");
    }
}

void tusmo_os_rmdir(char* path) {
    if (rmdir(path) != 0) {
        perror("rmdir");
    }
}

void tusmo_os_rmfile(char* path) {
    if (remove(path) != 0) {
        perror("remove");
    }
}

bool tusmo_os_path_exists(char* path) {
    struct stat buffer;
    return (stat(path, &buffer) == 0);
}

bool tusmo_os_is_file(char* path) {
    struct stat buffer;
    if (stat(path, &buffer) != 0) return false;
    return S_ISREG(buffer.st_mode);
}

bool tusmo_os_is_dir(char* path) {
    struct stat buffer;
    if (stat(path, &buffer) != 0) return false;
    return S_ISDIR(buffer.st_mode);
}

char* tusmo_os_getenv(char* name) {
    char* val = getenv(name);
    return val ? tusmo_strdup(val) : "";
}

void tusmo_os_setenv(char* name, char* value) {
    if (setenv(name, value, 1) != 0) {
        perror("setenv");
    }
}

int tusmo_os_system(char* command) {
    return system(command);
}

void tusmo_os_copy(char* source, char* destination) {
    pid_t pid = fork();
    if (pid == -1) {
        perror("fork");
        return;
    } else if (pid == 0) {
        execlp("cp", "cp", "-r", source, destination, (char *)NULL);
        perror("execlp");
        _exit(1);
    } else {
        int status;
        waitpid(pid, &status, 0);
    }
}

void tusmo_os_move_rename(char* old_path, char* new_path) {
    if (rename(old_path, new_path) != 0) {
        perror("rename");
    }
}

char* tusmo_os_read_file(char* path) {
    FILE* fp = fopen(path, "r");
    if (!fp) {
        perror("fopen");
        return "";
    }
    fseek(fp, 0, SEEK_END);
    long fsize = ftell(fp);
    fseek(fp, 0, SEEK_SET);
    char* content = (char*)malloc(fsize + 1);
    fread(content, 1, fsize, fp);
    fclose(fp);
    content[fsize] = 0;
    return content;
}

void tusmo_os_write_file(char* path, char* content, bool append) {
    FILE* fp = fopen(path, append ? "a" : "w");
    if (!fp) {
        perror("fopen");
        return;
    }
    fputs(content, fp);
    fclose(fp);
}

char* tusmo_os_path_join(char* part1, char* part2) {
    size_t len1 = strlen(part1);
    size_t len2 = strlen(part2);
    char* result = (char*)malloc(len1 + len2 + 2);
    strcpy(result, part1);
    if (result[len1 - 1] != '/' && part2[0] != '/') {
        strcat(result, "/");
    }
    strcat(result, part2);
    return result;
}

int tusmo_os_file_size(char* path) {
    struct stat st;
    if (stat(path, &st) == 0) {
        return st.st_size;
    }
    perror("stat");
    return -1;
}

char* tusmo_os_name() {
    #ifdef _WIN32
        return "windows";
    #elif __linux__
        return "linux";
    #elif __APPLE__
        return "macos";
    #elif __unix__
        return "unix";
    #else
        return "unknown";
    #endif
}
""");

