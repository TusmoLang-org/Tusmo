// stdlib/raylib/core.tus

___c__code_("""
#include "raylib.h"
""");

// Declare external C type explicitly for Tusmo's type checker/codegen.
qeex Color = Color;
qeex Vector2 = Vector2;
qeex Rectangle = Rectangle;

// 1. Qeexidda midabada (Native Raylib Constants)
qeex CAD    = WHITE;
qeex MADOW  = BLACK;
qeex CAS    = RED;
qeex BULUUG = BLUE;
qeex CAGAAR = GREEN;
qeex JAALLE = YELLOW;

// 1.1 Input constants
qeex GUJI_BIDIX = MOUSE_LEFT_BUTTON;
qeex FURE_BACKSPACE = KEY_BACKSPACE;
qeex FURE_ENTER = KEY_ENTER;

// 2. Hawlaha Raylib Wrapper
hawl bilow(ballac: tiro, dheer: tiro, cinwaan: eray) : waxbo {
    ___c__call_("InitWindow", ballac, dheer, cinwaan);
}

hawl daaqadu_ma_xirantahay() : miyaa {
    soo_celi ___c__call_("WindowShouldClose");
}

hawl bilaaw_sawirka() : waxbo {
    ___c__call_("BeginDrawing");
}

hawl dhameey_sawirka() : waxbo {
    ___c__call_("EndDrawing");
}

// Hadda waxaan u isticmaalaynaa 'Color' si toos ah (Value Type)
hawl nadiifi_asalka(midab: Color) : waxbo {
    ___c__call_("ClearBackground", midab);
}

hawl kuqor(qoraal: eray, x: tiro, y: tiro, cabir: tiro, midab: Color) : waxbo {
    ___c__call_("DrawText", qoraal, x, y, cabir, midab);
}

hawl xir_daaqada() : waxbo {
    ___c__call_("CloseWindow");
}

// 4. Drawing wrappers dheeraad ah
hawl sawir_leydi(x: tiro, y: tiro, w: tiro, h: tiro, midab: Color) : waxbo {
    ___c__call_("DrawRectangle", x, y, w, h, midab);
}

hawl sawir_leydi_xuduud(x: tiro, y: tiro, w: tiro, h: tiro, midab: Color) : waxbo {
    ___c__call_("DrawRectangleLines", x, y, w, h, midab);
}

hawl sawir_goobo(x: tiro, y: tiro, r: jajab, midab: Color) : waxbo {
    ___c__call_("DrawCircle", x, y, r, midab);
}

hawl dhig_fps(x: tiro, y: tiro) : waxbo {
    ___c__call_("DrawFPS", x, y);
}

// 5. Mouse helpers
hawl booska_mouse() : Vector2 {
    soo_celi ___c__call_("GetMousePosition");
}

hawl guduud_leydi(mouse: Vector2, rec: Rectangle) : miyaa {
    soo_celi ___c__call_("CheckCollisionPointRec", mouse, rec);
}

hawl guji_bidix_ayaa_dhacay() : miyaa {
    soo_celi ___c__call_("IsMouseButtonPressed", GUJI_BIDIX);
}

// 6. Button wrappers
hawl badhan(x: tiro, y: tiro, w: tiro, h: tiro, qoraal: eray, bg: Color, fg: Color) : miyaa {
    keyd:miyaa hover = guduud_leydi(booska_mouse(), (Rectangle){x, y, w, h});

    haddii (hover) {
        ___c__call_("DrawRectangleRec", (Rectangle){x, y, w, h}, ___c__call_("Fade", bg, 0.85));
    } haddii_kale {
        ___c__call_("DrawRectangleRec", (Rectangle){x, y, w, h}, bg);
    }

    ___c__call_("DrawText", qoraal, x + 12, y + 10, 20, fg);

    soo_celi hover iyo guji_bidix_ayaa_dhacay();
}

// 7. Text input wrappers
hawl hel_fure_char() : tiro {
    soo_celi ___c__call_("GetCharPressed");
}

hawl qoraal_jajab(qoraal: eray, bilow_idx: tiro, dhererka: tiro) : eray {
    soo_celi ___c__call_("TextSubtext", qoraal, bilow_idx, dhererka);
}

hawl xaraf_ilaa_eray(code: tiro) : eray {
    soo_celi ___c__call_("TextFormat", "%c", code);
}

hawl qoraal_geli_update(qoraal: eray, ugu_badnaan: tiro) : eray {
    keyd:tiro furaha = hel_fure_char();
    inta ay (furaha > 0) {
        haddii (furaha >= 32 iyo furaha <= 125 iyo dherer(qoraal) < ugu_badnaan) {
            qoraal = qoraal + xaraf_ilaa_eray(furaha);
        }
        furaha = hel_fure_char();
    }

    haddii (___c__call_("IsKeyPressed", FURE_BACKSPACE) iyo dherer(qoraal) > 0) {
        qoraal = qoraal_jajab(qoraal, 0, dherer(qoraal) - 1);
    }

    soo_celi qoraal;
}

hawl sawir_qoraal_geli(
    x: tiro,
    y: tiro,
    w: tiro,
    h: tiro,
    qoraal: eray,
    bg: Color,
    border: Color,
    text_color: Color
) : waxbo {
    ___c__call_("DrawRectangleRec", (Rectangle){x, y, w, h}, bg);
    ___c__call_("DrawRectangleLines", x, y, w, h, border);
    ___c__call_("DrawText", qoraal, x + 10, y + 10, 20, text_color);
}

// 3. Linker Setup
TUSMO_XIDID "libraylib";
TUSMO_XIDID "-lm.maya";
TUSMO_XIDID "-lGL.maya";
TUSMO_XIDID "-lX11.maya";
TUSMO_XIDID "-lpthread.maya";
TUSMO_XIDID "-ldl.maya";
TUSMO_XIDID "-lrt.maya";
