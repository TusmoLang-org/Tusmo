// stdlib/raylib/test.tus

isticmaal { CAD, MADOW, CAS, BULUUG, JAALLE, CAGAAR, Midab, Boos2D, AfarGees } ee kujira "noocyo";
isticmaal { bilowDaaqada, daaqadaMaXirantahay, bilowSawirka, dhameeySawirka, xirDaaqada } ee kujira "daaqad";
isticmaal { nadiifiShaashada } ee kujira "muuqaal";
isticmaal { qoraalKuQor } ee kujira "qoraal";
isticmaal { sawirQoraalGalis, cusboonaysiiQoraalGalis, sameeBadhan } ee kujira "dhexgalka";

keyd:eray user_input = "";
keyd:miyaa was_clicked = been;

bilowDaaqada(800, 600, "Tusmo Raylib - Final Somali API Test");

inta ay (daaqadaMaXirantahay() == been) {
    bilowSawirka();
    nadiifiShaashada(MADOW);

    qoraalKuQor("Raylib using improved Tusmo Structs & Somali Names!", 100, 50, 24, CAD);

    // Text input box
    sawirQoraalGalis(100, 100, 400, 50, user_input, CAD, BULUUG, JAALLE);
    user_input = cusboonaysiiQoraalGalis(user_input, 30);

    // Submit button
    keyd:miyaa submit_btn = sameeBadhan(100, 170, 200, 50, "Submit", CAS, MADOW);

    // Track click
    haddii (submit_btn == haa) {
        was_clicked = haa;
    }

    // Show submitted text
    haddii (was_clicked == haa) {
        qoraalKuQor("You typed: " + user_input, 100, 240, 24, CAGAAR);
        qoraalKuQor("Press BACKSPACE to clear and try again!", 100, 270, 18, JAALLE);
    }

    dhameeySawirka();
}

xirDaaqada();
