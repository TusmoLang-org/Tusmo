// stdlib/wakhti.tus

___c__code_("""
#include <time.h>
#include <unistd.h>
#include <stdlib.h>

double tusmo_time() {
    return (double)time(NULL);
}

int tusmo_wait(int number) {
    unsigned int remaining = sleep((unsigned int)number); 
    if (remaining == 0) {
        return 0;
    } else {
        return (int)remaining;
    }
}

char* tusmo_time_now() {
    char buffer[20];
    time_t rawtime;
    struct tm *timeinfo;
    time(&rawtime);
    timeinfo = localtime(&rawtime);
    strftime(buffer, sizeof(buffer), "%Y-%m-%d %H:%M:%S", timeinfo);
    return tusmo_strdup(buffer);
}

char* tusmo_format_time(const char* format) {
    time_t rawtime;
    struct tm * timeinfo;
    char * buffer = (char *)malloc(80 * sizeof(char));
    time(&rawtime);
    timeinfo = localtime(&rawtime);
    strftime(buffer, 80, format, timeinfo);
    return buffer;
}

int tusmo_get_seconds() {
    time_t rawtime;
    struct tm * timeinfo;
    time(&rawtime);
    timeinfo = localtime(&rawtime);
    return timeinfo->tm_sec;
}

int tusmo_get_minutes() {
    time_t rawtime;
    struct tm * timeinfo;
    time(&rawtime);
    timeinfo = localtime(&rawtime);
    return timeinfo->tm_min;
}

int tusmo_get_hours() {
    time_t rawtime;
    struct tm * timeinfo;
    time(&rawtime);
    timeinfo = localtime(&rawtime);
    return timeinfo->tm_hour;
}

int tusmo_get_day() {
    time_t rawtime;
    struct tm * timeinfo;
    time(&rawtime);
    timeinfo = localtime(&rawtime);
    return timeinfo->tm_mday;
}

int tusmo_get_month() {
    time_t rawtime;
    struct tm * timeinfo;
    time(&rawtime);
    timeinfo = localtime(&rawtime);
    return timeinfo->tm_mon + 1;
}

int tusmo_get_year() {
    time_t rawtime;
    struct tm * timeinfo;
    time(&rawtime);
    timeinfo = localtime(&rawtime);
    return timeinfo->tm_year + 1900;
}
""");

koox Wakhti {
    """
    Koox wakhti oo bixisa 7 hawlood:
    - hadda(): unix timestamp.
    - qaabee(): format wakhti sida strftime.
    - sekeno/daqiiqado/saacado: qaybaha wakhtiga hada.
    - maalin/bil/sanad: xogta taariikhda maanta.
    - seexo(): seexo ilbiriqsiyo la tilmaamay.
    """

    hawl wakhti() : jajab {
        """Soo celi unix timestamp (ilbiriqsiyo jajab ah)."""
        soo_celi ___c__call_("tusmo_time");
    }

    hawl hadda() : eray {
        """Soo celi waqtiga hadda ee qaab akhris fudud."""
        soo_celi ___c__call_("tusmo_time_now");
    }

    hawl qaabee(format: eray) : eray {
        """Qaabee wakhtiga hadda la joogo adigoo adeegsanaya kalmadaha format."""
        soo_celi ___c__call_("tusmo_format_time", format);
    }

    hawl sekeno() : tiro {
        """Soo celi ilbiriqsiyada hadda (0-59)."""
        soo_celi ___c__call_("tusmo_get_seconds");
    }

    hawl daqiiqado() : tiro {
        """Soo celi daqiiqadaha hadda (0-59)."""
        soo_celi ___c__call_("tusmo_get_minutes");
    }

    hawl saacado() : tiro {
        """Soo celi saacadaha hadda (0-23)."""
        soo_celi ___c__call_("tusmo_get_hours");
    }

    hawl maalin() : tiro {
        """Soo celi maalinta bisha (1-31)."""
        soo_celi ___c__call_("tusmo_get_day");
    }

    hawl bil() : tiro {
        """Soo celi bisha (1-12)."""
        soo_celi ___c__call_("tusmo_get_month");
    }

    hawl sanad() : tiro {
        """Soo celi sanadka buuxa."""
        soo_celi ___c__call_("tusmo_get_year");
    }

    hawl seexo(sekeno: tiro) : waxbo {
        """Seexo tirada ilbiriqsiyada ee la tilmaamay."""
        ___c__call_("tusmo_wait", sekeno);
    }
}
